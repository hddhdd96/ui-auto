# Mock 포털 실행 설정. 실행할 때 환경변수로 넘긴다. 예: TRANSITION_DELAY_MS=300 npm run portal
# 모든 값은 가상이며 실제 서비스 정보가 아니다.

# 포털 포트
PORTAL_PORT=4173

# 상태 전이(CREATING → ACTIVE, DELETING → 삭제 등)에 걸리는 시간(ms)
TRANSITION_DELAY_MS=1000

# 로그인 토큰 유효 시간(초). 짧게 줄이면 실행 중 세션 만료를 재현할 수 있다.
TOKEN_TTL_SEC=3600

# (이후 단계에서 결함 주입, Flaky 주입 플래그가 추가된다)
