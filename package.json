{
  "name": "ui-auto",
  "version": "2.0.0",
  "private": true,
  "description": "Public QA portfolio demo: Playwright POM, TC-ID suites, flaky self-healing, CI assertion guardrail",
  "scripts": {
    "test": "playwright test --project=unit --project=suites",
    "test:tc": "playwright test --project=tc",
    "test:suites": "playwright test --project=suites",
    "test:unit": "playwright test --project=unit",
    "test:headed": "playwright test --project=suites --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "guardrail": "python3 guardrail/check_test_weakening.py --base origin/main",
    "guardrail:selftest": "python3 -m unittest discover -s guardrail -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.3"
  }
}
