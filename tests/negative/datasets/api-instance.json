{
  "area": "인스턴스",
  "description": "인스턴스 생성·사양 변경·삭제의 입력 규칙과 상태 규칙",
  "riskReason": "쿼터 초과와 진행 중 상태의 작업은 UI에서는 막히지만 API로는 그대로 요청할 수 있어 결함이 자주 나는 영역이다.",
  "cases": [
    {
      "id": "NEG-INST-001",
      "title": "이름을 빠뜨리면 400 REQUIRED",
      "category": "required",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "flavorId": "small",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 400,
        "code": "REQUIRED",
        "field": "name"
      },
      "verify": [
        {
          "kind": "instances",
          "name": "",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-INST-002",
