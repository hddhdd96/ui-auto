    {
      "id": "NEG-INST-015",
      "title": "인스턴스 수 쿼터를 넘으면 409 QUOTA_EXCEEDED",
      "category": "quota",
      "risk": "high",
      "setup": [
        {
          "type": "instance",
          "as": "first"
        },
        {
          "type": "quota",
          "values": {
            "instances": 1
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "name": "{{unique}}",
          "flavorId": "small",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 409,
        "code": "QUOTA_EXCEEDED"
      },
      "verify": [
        {
          "kind": "instances",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-INST-016",
      "title": "vCPU 쿼터를 넘는 사양이면 409 QUOTA_EXCEEDED",
      "category": "quota",
      "risk": "high",
      "setup": [
        {
          "type": "quota",
          "values": {
            "vcpus": 7
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "name": "{{unique}}",
          "flavorId": "xlarge",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 409,
        "code": "QUOTA_EXCEEDED"
      },
      "verify": [
        {
          "kind": "instances",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-INST-017",
      "title": "현재와 같은 사양으로 변경하면 400 SAME_FLAVOR이고 사양은 그대로다",
      "category": "state",
      "risk": "normal",
      "setup": [
        {
          "type": "instance",
          "as": "inst"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances/{{inst.id}}/resize",
        "body": {
          "flavorId": "small"
        }
      },
      "expect": {
        "status": 400,
        "code": "SAME_FLAVOR",
        "field": "flavorId"
      },
      "verify": [
        {
          "kind": "instances",
          "id": "{{inst.id}}",
          "fields": {
            "status": "ACTIVE",
            "flavorId": "small"
          }
        }
      ]
    },
    {
      "id": "NEG-INST-018",
      "title": "사양 변경으로 vCPU 쿼터를 넘으면 409 QUOTA_EXCEEDED이고 사양은 그대로다",
      "category": "quota",
      "risk": "high",
      "setup": [
        {
          "type": "instance",
          "as": "inst"
        },
        {
          "type": "quota",
          "values": {
            "vcpus": 3
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances/{{inst.id}}/resize",
        "body": {
          "flavorId": "large"
        }
      },
      "expect": {
        "status": 409,
        "code": "QUOTA_EXCEEDED"
      },
      "verify": [
        {
          "kind": "instances",
          "id": "{{inst.id}}",
          "fields": {
            "status": "ACTIVE",
            "flavorId": "small"
          }
        }
      ]
    },
    {
      "id": "NEG-INST-019",
      "title": "생성 중(CREATING)인 인스턴스의 사양을 바꾸면 409 INVALID_STATE",
      "category": "state",
      "risk": "high",
      "setup": [
        {
          "type": "instanceCreating",
          "as": "busy"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances/{{busy.id}}/resize",
        "body": {
          "flavorId": "medium"
        }
      },
      "expect": {
        "status": 409,
        "code": "INVALID_STATE"
      },
      "verify": [
        {
          "kind": "instances",
          "id": "{{busy.id}}",
          "fields": {
            "flavorId": "small"
          },
          "statusIn": [
            "CREATING",
            "ACTIVE"
          ]
        }
      ]
    },
    {
      "id": "NEG-INST-020",
      "title": "생성 중(CREATING)인 인스턴스를 삭제하면 400 INVALID_STATE이고 삭제가 시작되지 않는다",
      "category": "state",
      "risk": "high",
      "setup": [
        {
          "type": "instanceCreating",
          "as": "busy"
        }
      ],
      "request": {
        "method": "DELETE",
        "path": "/instances/{{busy.id}}"
      },
      "expect": {
        "status": 400,
        "code": "INVALID_STATE"
      },
      "verify": [
        {
          "kind": "instances",
          "id": "{{busy.id}}",
          "statusIn": [
            "CREATING",
            "ACTIVE"
          ]
        }
      ]
    }
  ]
}
