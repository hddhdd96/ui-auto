    {
      "id": "NEG-INST-011",
      "title": "같은 이름의 인스턴스가 있으면 409 DUPLICATE_NAME",
      "category": "duplicate",
      "risk": "normal",
      "setup": [
        {
          "type": "instance",
          "as": "dup"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "name": "{{dup.name}}",
          "flavorId": "small",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 409,
        "code": "DUPLICATE_NAME"
      },
      "verify": [
        {
          "kind": "instances",
          "name": "{{dup.name}}",
          "count": 1
        }
      ]
    },
    {
      "id": "NEG-INST-012",
      "title": "사양을 빠뜨리면 400 REQUIRED",
      "category": "required",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "name": "{{unique}}",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 400,
        "code": "REQUIRED",
        "field": "flavorId"
      },
      "verify": [
        {
          "kind": "instances",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-INST-013",
      "title": "없는 사양이면 400 INVALID_REFERENCE",
      "category": "reference",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/instances",
        "body": {
          "name": "{{unique}}",
          "flavorId": "huge",
          "networkId": "{{project.network}}"
        }
      },
      "expect": {
        "status": 400,
