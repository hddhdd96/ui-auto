{
  "area": "네트워크·보안 그룹",
  "description": "IP 대역(CIDR) 형식·범위·중복 규칙과 보안 그룹 규칙 형식",
  "riskReason": "서브넷 IP 대역 중복과 범위 검사는 입력 조합이 많아 누락되기 쉬운 영역이다.",
  "cases": [
    {
      "id": "NEG-NET-001",
      "title": "IP 대역 형식이 틀리면(옥텟 3개) 400 INVALID_FORMAT",
      "category": "format",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.0.0/16"
        }
      },
      "expect": {
        "status": 400,
        "code": "INVALID_FORMAT",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-NET-002",
      "title": "옥텟이 255를 넘으면 400 INVALID_FORMAT",
      "category": "format",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.256.0.0/16"
        }
      },
      "expect": {
        "status": 400,
        "code": "INVALID_FORMAT",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-NET-003",
      "title": "네트워크 prefix가 /15(최소 /16 미만)면 400 OUT_OF_RANGE",
      "category": "boundary",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.0.0.0/15"
        }
      },
      "expect": {
        "status": 400,
        "code": "OUT_OF_RANGE",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-NET-004",
      "title": "네트워크 prefix가 /25(최대 /24 초과)면 400 OUT_OF_RANGE",
      "category": "boundary",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.70.0.0/25"
        }
      },
      "expect": {
        "status": 400,
        "code": "OUT_OF_RANGE",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-NET-005",
      "title": "호스트 비트가 0이 아닌 주소면 400 INVALID_FORMAT",
      "category": "format",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.70.0.1/16"
        }
      },
      "expect": {
        "status": 400,
        "code": "INVALID_FORMAT",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-NET-006",
      "title": "서브넷이 네트워크 대역을 벗어나면 400 OUT_OF_RANGE",
      "category": "boundary",
      "risk": "high",
      "setup": [
        {
          "type": "network",
          "as": "net",
          "cidr": "10.60.0.0/16"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/networks/{{net.id}}/subnets",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.61.0.0/24"
        }
      },
      "expect": {
        "status": 400,
        "code": "OUT_OF_RANGE",
        "field": "cidr"
      },
      "verify": [
        {
          "kind": "networks",
          "id": "{{net.id}}",
          "fields": {
            "subnets": []
          }
        }
      ]
    },
    {
      "id": "NEG-NET-007",
      "title": "기존 서브넷과 대역이 겹치면 409 CIDR_OVERLAP",
      "category": "duplicate",
      "risk": "high",
      "setup": [
        {
          "type": "network",
          "as": "net",
          "cidr": "10.62.0.0/16",
          "subnets": [
            "10.62.1.0/24"
          ]
        }
      ],
      "request": {
        "method": "POST",
        "path": "/networks/{{net.id}}/subnets",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.62.1.128/25"
        }
      },
      "expect": {
        "status": 409,
        "code": "CIDR_OVERLAP"
      },
      "verify": [
        {
          "kind": "networks",
          "id": "{{net.id}}",
          "fields": {
            "subnets": [
              {
                "cidr": "10.62.1.0/24"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "NEG-NET-008",
      "title": "네트워크 수 쿼터를 넘으면 409 QUOTA_EXCEEDED",
      "category": "quota",
      "risk": "high",
      "setup": [
        {
          "type": "quota",
          "values": {
            "networks": 1
          }
        }
      ],
      "request": {
        "method": "POST",
        "path": "/networks",
        "body": {
          "name": "{{unique}}",
          "cidr": "10.63.0.0/16"
        }
      },
      "expect": {
        "status": 409,
        "code": "QUOTA_EXCEEDED"
      },
      "verify": [
        {
          "kind": "networks",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-SG-001",
      "title": "규칙 포트가 0이면 400 OUT_OF_RANGE",
      "category": "boundary",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/security-groups",
        "body": {
          "name": "{{unique}}",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "tcp",
              "port": 0,
              "cidr": "0.0.0.0/0"
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "OUT_OF_RANGE",
        "field": "rules.port"
      },
      "verify": [
        {
          "kind": "security-groups",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-SG-002",
      "title": "규칙 포트가 65536이면 400 OUT_OF_RANGE",
      "category": "boundary",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/security-groups",
        "body": {
          "name": "{{unique}}",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "tcp",
              "port": 65536,
              "cidr": "0.0.0.0/0"
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "OUT_OF_RANGE",
        "field": "rules.port"
      },
      "verify": [
        {
          "kind": "security-groups",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-SG-003",
      "title": "지원하지 않는 프로토콜이면 400 INVALID_FORMAT",
      "category": "format",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/security-groups",
        "body": {
          "name": "{{unique}}",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "http",
              "port": 443,
              "cidr": "0.0.0.0/0"
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "INVALID_FORMAT",
        "field": "rules.protocol"
      },
      "verify": [
        {
          "kind": "security-groups",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    },
    {
      "id": "NEG-SG-004",
      "title": "규칙의 허용 IP 대역 형식이 틀리면 400 INVALID_FORMAT",
      "category": "format",
      "risk": "normal",
      "request": {
        "method": "POST",
        "path": "/security-groups",
        "body": {
          "name": "{{unique}}",
          "rules": [
            {
              "direction": "ingress",
              "protocol": "tcp",
              "port": 443,
              "cidr": "any"
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "code": "INVALID_FORMAT",
        "field": "rules.cidr"
      },
      "verify": [
        {
          "kind": "security-groups",
          "name": "{{unique}}",
          "count": 0
        }
      ]
    }
  ]
}
